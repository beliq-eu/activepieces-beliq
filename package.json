{
  "name": "activepieces-beliq",
  "version": "0.2.5",
  "description": "beliq connector for Activepieces: generate, validate, parse, and convert EU-compliant e-invoices (XRechnung, ZUGFeRD, Factur-X, Peppol BIS).",
  "keywords": [
    "activepieces",
    "activepieces-piece",
    "beliq",
    "e-invoice",
    "einvoice",
    "xrechnung",
    "zugferd",
    "factur-x",
    "peppol",
    "en16931",
    "compliance"
  ],
  "license": "MIT",
  "homepage": "https://beliq.eu",
  "author": "beliq <hello@beliq.eu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beliq-eu/activepieces-beliq.git"
  },
  "main": "./dist/src/index.js",
  "engines": {
    "node": ">=18.20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && node scripts/prepare-dist.mjs",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "lint": "eslint src",
    "lintfix": "eslint src --fix",
    "test": "vitest run --exclude test/integration.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "scrub:check": "bash scripts/scrub-check.sh"
  },
  "dependencies": {
    "@activepieces/pieces-framework": "0.32.0",
    "@activepieces/shared": "0.96.2",
    "@beliq/sdk": "^0.4.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.4",
    "vitest": "^4.0.0"
  }
}
